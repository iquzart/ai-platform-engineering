PORT=8080
SERVICE_NAME=chat-app
VERSION=dev
LOG_LEVEL=info
TRACING_ENABLED=false
OTLP_ENDPOINT=otel-collector:4317
SHUTDOWN_TIMEOUT=5s
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=3600s
REDIS_ADDR=redis:6379
# Replace with a locally generated secret. Do not commit the resulting .env file.
REDIS_PASSWORD=replace-with-a-unique-local-redis-password
# Docker Desktop for macOS: LiteLLM reaches host-run Ollama through this address.
# Override with an accessible Ollama server URL when Docker cannot reach the host.
OLLAMA_API_BASE=http://host.docker.internal:11434
# Locally generated credential used by the application to call LiteLLM's OpenAI-compatible API.
LITELLM_MASTER_KEY=replace-with-a-unique-local-litellm-master-key
# For a host-run application, use LiteLLM at localhost and set this to the same value
# as LITELLM_MASTER_KEY. Compose overrides both values with its internal endpoint/key.
OPENAI_BASE_URL=http://localhost:4000/v1
OPENAI_API_KEY=replace-with-the-same-value-as-litellm-master-key
# Dashboard credentials. Use a unique password; do not reuse the master key.
LITELLM_UI_USERNAME=replace-with-a-local-dashboard-username
LITELLM_UI_PASSWORD=replace-with-a-unique-local-dashboard-password
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b
PROMPT_VERSION=v1
# 0 discovers the dimension from the first embedding; set a positive value to validate it.
EMBEDDING_DIMENSION=0
