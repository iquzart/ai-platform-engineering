# Copy to .env and replace with a local-only, non-production password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-local-password

# Image policy: use exact, current stable upstream release tags. Do not use
# floating tags (including `latest`); update these values after validating a
# compatible stack.
OTEL_COLLECTOR_VERSION=0.161.0
PROMETHEUS_VERSION=v3.14.0
TEMPO_VERSION=3.0.3
LOKI_VERSION=3.7.8
GRAFANA_VERSION=13.2.2

# Host ports are deliberately loopback-only in docker-compose.yaml.
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
